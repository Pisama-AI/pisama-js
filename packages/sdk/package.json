{
  "name": "@pisama/sdk",
  "version": "0.9.0-alpha.4",
  "description": "Vercel AI SDK middleware for privacy-filtered agent tracing and Pisama failure detection.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/integration/**/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=75 test/*.test.ts test/integration/**/*.test.ts"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "ai": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": { "optional": true }
  },
  "dependencies": {
    "@pisama/detectors": "workspace:*",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "ai": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "zod": "^4.0.0"
  },
  "keywords": [
    "ai",
    "llm",
    "agent",
    "observability",
    "vercel",
    "ai-sdk",
    "middleware",
    "typescript",
    "failure-detection",
    "tracing"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Pisama-AI/pisama-js/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pisama-AI/pisama-js.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Pisama-AI/pisama-js/issues"
  }
}
