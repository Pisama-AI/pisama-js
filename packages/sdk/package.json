{
  "name": "@pisama/sdk",
  "version": "0.9.0-alpha.1",
  "description": "Catch silent failures in your AI agents. TypeScript SDK for Pisama, the failure detector for vibe-coded agents (Cursor, Claude Code, LangGraph, Vercel AI SDK).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/integration/**/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=75 test/*.test.ts test/integration/**/*.test.ts"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "ai": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": { "optional": true }
  },
  "dependencies": {
    "@pisama/detectors": "workspace:*",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "ai": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "zod": "^4.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "observability",
    "vercel",
    "ai-sdk",
    "failure-detection",
    "tracing"
  ],
  "license": "MIT",
  "homepage": "https://pisama.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pisama-AI/pisama-js",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Pisama-AI/pisama-js/issues"
  }
}
