{
  "name": "@whoopsie/detectors",
  "version": "0.7.0",
  "description": "Compatibility bridge from the retired @whoopsie/detectors name to @pisama/detectors.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node --check index.js",
    "typecheck": "node --check index.js",
    "test": "tsx --test test/bridge.test.ts",
    "test:coverage": "tsx --test test/bridge.test.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@pisama/detectors": "workspace:0.10.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "failure-detection",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Pisama-AI/pisama-js",
    "directory": "packages/whoopsie-detectors"
  },
  "homepage": "https://pisama.ai",
  "bugs": {
    "url": "https://github.com/Pisama-AI/pisama-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
