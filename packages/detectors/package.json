{
  "name": "@pisama/detectors",
  "version": "0.10.0",
  "description": "TypeScript-native failure detectors for AI agent traces.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=75 src/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "failure-detection",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Pisama-AI/pisama-js",
    "directory": "packages/detectors"
  },
  "homepage": "https://pisama.ai",
  "bugs": {
    "url": "https://github.com/Pisama-AI/pisama-js/issues"
  }
}
