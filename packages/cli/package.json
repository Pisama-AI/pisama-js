{
  "name": "@pisama/cli",
  "version": "0.10.2",
  "description": "CLI for Pisama. `init` patches your project, `verify` round-trips a synthetic trace, `mcp` runs the MCP server, `analyze-atif` runs Pisama detectors on Harbor trajectories.",
  "type": "module",
  "bin": {
    "pisama": "./dist/bin.js",
    "pisama-ts": "./dist/bin.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/mcp.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/mcp.js --legal-comments=inline",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=75 test/*.test.ts"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "kleur": "^4.1.5",
    "nanoid": "^5.0.0",
    "open": "^10.0.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pisama-AI/pisama-js",
    "directory": "packages/cli"
  },
  "homepage": "https://pisama.ai",
  "bugs": {
    "url": "https://github.com/Pisama-AI/pisama-js/issues"
  }
}
