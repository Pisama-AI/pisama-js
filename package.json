{
  "name": "pisama-js",
  "private": true,
  "version": "0.0.0",
  "description": "Public TypeScript packages for Pisama agent failure detection.",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages/{sdk,detectors,cli}/src",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx}\"",
    "test": "pnpm build && pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.0"
  }
}
