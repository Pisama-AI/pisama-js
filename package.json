{
  "name": "pisama-js",
  "private": true,
  "version": "0.0.0",
  "description": "Public TypeScript packages for Pisama agent failure detection.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "lint": "eslint packages/sdk/src packages/detectors/src packages/cli/src packages/whoopsie-cli/src && pnpm verify:release-workflows",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx}\"",
    "test": "pnpm build && pnpm -r test",
    "test:coverage": "pnpm build && pnpm -r test:coverage",
    "audit:production": "pnpm audit --prod --audit-level moderate",
    "audit:bundle-inputs": "pnpm audit --dev --audit-level moderate",
    "verify:release-workflows": "node scripts/verify-release-workflows.mjs"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.11",
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.6",
      "hono": "4.13.5",
      "ip-address": "10.3.1",
      "qs": "6.16.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
